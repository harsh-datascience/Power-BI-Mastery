# syntax=docker/dockerfile:1

# ─── Stage 1: dependencies ────────────────────────────────────────
FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Enable pnpm via corepack
RUN corepack enable && corepack prepare pnpm@8.15.4 --activate

# Copy only manifests first for better layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/
COPY packages/database/package.json ./packages/database/

RUN pnpm install --frozen-lockfile

# ─── Stage 2: builder ─────────────────────────────────────────────
FROM node:20-alpine AS builder
RUN apk add --no-cache libc6-compat
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@8.15.4 --activate

# Bring in installed dependencies
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules

# Copy source. query-languages/ is required at build time because
# content.ts reads it to statically generate all 798 doc pages.
COPY . .

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV DOCKER_BUILD=true

# Build (produces .next/standalone with Next.js output:'standalone')
RUN pnpm --filter web run build

# ─── Stage 3: runner ──────────────────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# IMPORTANT (monorepo layout):
# With a pnpm workspace, Next.js standalone output keeps the workspace
# structure. The generated server entrypoint lives at:
#     .next/standalone/apps/web/server.js
# and shared node_modules live at:
#     .next/standalone/node_modules
# So we copy the whole standalone tree to /app and start the nested
# server.js. Copying only the inner apps/web folder would break module
# resolution for hoisted workspace dependencies.
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./

# Static assets are not included in the standalone trace, copy explicitly
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public

USER nextjs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/api/health || exit 1

# Entrypoint is the nested server.js produced for the web workspace
CMD ["node", "apps/web/server.js"]
