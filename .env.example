# ============================================
# Power BI Mastery - Environment Variables
# ============================================
# Copy this file to .env.local and fill values

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Power BI Mastery"
NEXT_PUBLIC_APP_DESCRIPTION="Master DAX & Power Query M Language"

# --- Database (Neon PostgreSQL) ---
DATABASE_URL="postgresql://user:password@db.neon.tech/powerbimastery?sslmode=require"
DATABASE_SHADOW_URL="postgresql://user:password@db.neon.tech/powerbimastery_shadow?sslmode=require"

# --- Auth (NextAuth v5) ---
NEXTAUTH_SECRET="your-32-char-minimum-secret-here"

# OAuth Providers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Entra directory (tenant) ID, or "common" for any Microsoft account.
# Callback URL: <app>/api/auth/callback/microsoft-entra-id
MICROSOFT_TENANT_ID="common"

# --- Redis (Upstash) ---
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# --- Search (Algolia) ---
NEXT_PUBLIC_ALGOLIA_APP_ID=""
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=""
ALGOLIA_ADMIN_KEY=""
NEXT_PUBLIC_ALGOLIA_INDEX_NAME="powerbimastery_docs"

# --- Analytics ---
NEXT_PUBLIC_VERCEL_ANALYTICS=true
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# --- Monitoring (Sentry) ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="noreply@powerbimastery.com"

# --- Storage (Cloudflare R2 / AWS S3) ---
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET_NAME="powerbimastery"
STORAGE_PUBLIC_URL=""

# --- Content ---
CONTENT_SOURCE_PATH="./query-languages"
CONTENT_OUTPUT_PATH="./apps/web/src/content/generated"

# --- Feature Flags ---
NEXT_PUBLIC_FEATURE_PLAYGROUND=true
NEXT_PUBLIC_FEATURE_COMMUNITY=false
NEXT_PUBLIC_FEATURE_AI_SEARCH=false
